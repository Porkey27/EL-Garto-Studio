{
  "name": "el-garto-studio",
  "productName": "El-Garto Studio",
  "version": "0.1.0",
  "description": "El-Garto Studio: unofficial Linux and Windows app for Elgato capture cards, Facecams and Prompter",
  "author": "Porkey27",
  "homepage": "https://github.com/Porkey27/EL-Garto-Studio",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build:native": "node scripts/build-native.js",
    "firmware": "node tools/firmware-update.js",
    "dist": "npm run build:native && electron-builder",
    "dist:linux": "npm run build:native && electron-builder --linux AppImage deb tar.gz --publish never",
    "dist:win": "npm run build:native && electron-builder --win nsis --publish never && node scripts/zip-win.js"
  },
  "dependencies": {
    "vosk-browser": "^0.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.porkey27.el-garto-studio",
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "extraResources": [
        {
          "from": "native/build",
          "to": "native",
          "filter": [
            "egctl"
          ]
        },
        {
          "from": "udev",
          "to": "udev"
        }
      ],
      "icon": "assets/icon.png",
      "maintainer": "Porkey27 <79101219+Porkey27@users.noreply.github.com>",
      "synopsis": "Unofficial app for Elgato capture cards and cameras",
      "artifactName": "el-garto-studio-${version}-linux-x64.${ext}"
    },
    "deb": {
      "depends": [
        "ffmpeg",
        "v4l-utils"
      ],
      "afterInstall": "udev/postinst.sh",
      "artifactName": "el-garto-studio-${version}-linux-amd64.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "native/build",
          "to": "native",
          "filter": [
            "egctl.exe",
            "egcap.exe"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "el-garto-studio-${version}-windows-setup.${ext}"
    },
    "artifactName": "el-garto-studio-${version}-${os}-${arch}.${ext}",
    "appImage": {
      "artifactName": "el-garto-studio-${version}-linux.${ext}"
    }
  }
}
